#version 460 core

#extension GL_NV_mesh_shader : require
#extension GL_ARB_bindless_texture : require

// Only include struct definitions, NOT StaticUniformBuffers.glsl or Meshlet.glsl
// to avoid exceeding the per-stage SSBO limit.
#include<..\..\..\resources\shaders\include\CommonTypes.glsl>
#include<..\..\..\resources\shaders\include\GpuTypes.glsl>
#include<..\..\..\resources\shaders\include\Compression.glsl>

#define MESHLET_MAX_VERTEX_COUNT 128
#define MESHLET_MAX_TRIANGLE_COUNT 252

layout(local_size_x = 32) in;
layout(triangles, max_vertices = MESHLET_MAX_VERTEX_COUNT, max_primitives = MESHLET_MAX_TRIANGLE_COUNT) out;

// === UBOs ===
layout(std140, binding = 0) uniform PerFrameDataUBO
{
    PerFrameData perFrameDataUBO;
};

// === Inline struct definitions ===
struct GpuMeshlet {
    uint VertexOffset;
    uint IndicesOffset;
    uint VertexCount;
    uint TriangleCount;
};

// === SSBOs (only the ones this shader actually reads) ===

layout(std430, binding = 8) restrict readonly buffer VertexDataSSBO {
    Vertex vertices[];
} vertexDataSSBO;

layout(std430, binding = 11) restrict readonly buffer MeshletSSBO {
    GpuMeshlet Meshlets[];
} meshletSSBO;

layout(std430, binding = 13) restrict readonly buffer MeshletVertexIndicesSSBO {
    uint VertexIndices[];
} meshletVertexIndicesSSBO;

layout(std430, binding = 14) restrict readonly buffer MeshletLocalIndicesSSBO {
    uint PackedIndices[];
} meshletLocalIndicesSSBO;

layout(std430, binding = 19) restrict readonly buffer TransformPaletteSSBO {
    mat4 Transforms[];
} transformPaletteSSBO;

layout(std430, binding = 20) restrict readonly buffer PrevTransformPaletteSSBO {
    mat4 Transforms[];
} prevTransformPaletteSSBO;

layout(std430, binding = 22) restrict readonly buffer RenderItemPoolSSBO {
    GpuRenderItem RenderItems[];
} renderItemPoolSSBO;

taskNV in Task {
    uint MeshletIndices[32];
    uint RenderItemId;
} IN;

out InOutData
{
    vec2 TexCoord;
    vec3 Normal;
    vec3 Tangent;
    vec4 ClipPos;
    vec4 PrevClipPos;
    flat uint MaterialId;
} outData[];

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint meshletIndex = IN.MeshletIndices[gl_WorkGroupID.x];

    GpuRenderItem item = renderItemPoolSSBO.RenderItems[IN.RenderItemId];
    GpuMeshlet meshlet = meshletSSBO.Meshlets[meshletIndex];

    // Set output counts
    gl_PrimitiveCountNV = meshlet.TriangleCount;

    // Read transforms from palette
    mat4 worldMat = transformPaletteSSBO.Transforms[item.transformIndex];
    mat4 prevWorldMat = prevTransformPaletteSSBO.Transforms[item.transformIndex];
    mat4 mvp = perFrameDataUBO.ProjView * worldMat;
    mat4 prevMvp = perFrameDataUBO.PrevProjView * prevWorldMat;
    mat3 unitVecToWorld = mat3(transpose(inverse(worldMat)));

    // Process vertices - each thread handles multiple vertices
    for (uint i = tid; i < meshlet.VertexCount; i += 32)
    {
        uint vertexIndex = meshletVertexIndicesSSBO.VertexIndices[meshlet.VertexOffset + i];
        Vertex v = vertexDataSSBO.vertices[vertexIndex];

        vec4 clipPos = mvp * v.position;
        gl_MeshVerticesNV[i].gl_Position = clipPos;
        outData[i].TexCoord = v.texCoords;
        outData[i].Normal = normalize(unitVecToWorld * DecompressSR11G11B10(v.normal));
        outData[i].Tangent = normalize(unitVecToWorld * DecompressSR11G11B10(v.tangent));
        outData[i].ClipPos = clipPos;
        outData[i].PrevClipPos = prevMvp * v.position;
        outData[i].MaterialId = item.materialId;
    }

    // Process triangles - packed as 3 uint8s per triangle into uint32s
    uint packedCount = (meshlet.TriangleCount * 3 + 3) / 4;
    for (uint i = tid; i < packedCount; i += 32)
    {
        writePackedPrimitiveIndices4x8NV(i * 4, meshletLocalIndicesSSBO.PackedIndices[meshlet.IndicesOffset + i]);
    }
}
