#version 460 core

#extension GL_ARB_bindless_texture : require
#extension GL_EXT_shader_image_load_formatted : require

#include<..\..\..\resources\shaders\include\HairTypes.glsl>

layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;

layout(binding = 0, rgba16f) restrict uniform image3D HairMeshImage;
layout(binding = 1, rgba16f) restrict uniform image3D HairUImage;
layout(binding = 2, rgba16f) restrict uniform image3D HairVImage;

vec3 HairRebuildSafeNormalize(vec3 value, vec3 fallback)
{
    float len2 = dot(value, value);
    if (len2 <= 1e-8)
    {
        return fallback;
    }
    return value * inversesqrt(len2);
}

uint PatchVertexCount()
{
    return uint(hairAssetUBO.hairAsset.Counts.y + 1);
}

uint LayerVertexCount()
{
    uint patchVertexCount = PatchVertexCount();
    return patchVertexCount * patchVertexCount;
}

uint ControlIndex(uint layerIndex, uint vertexX, uint vertexZ)
{
    return layerIndex * LayerVertexCount() + vertexZ * PatchVertexCount() + vertexX;
}

vec3 ReadSimPosition(uint layerIndex, uint vertexX, uint vertexZ)
{
    return hairSimulationWriteSSBO.WritePoints[ControlIndex(layerIndex, vertexX, vertexZ)].Position.xyz;
}

vec3 ComputeSlicePoint(vec3 previous, vec3 current, vec3 next, vec3 after, int stepIndex)
{
    vec3 cubic0 = current;
    vec3 cubic1 = current + (next - previous) / 6.0;
    vec3 cubic2 = next - (after - current) / 6.0;
    vec3 cubic3 = next;

    if (stepIndex == 0)
    {
        return cubic0;
    }
    if (stepIndex == 4)
    {
        return cubic3;
    }

    float t = (stepIndex == 1) ? 0.25 : ((stepIndex == 2) ? 0.5 : 0.75);
    float u = 1.0 - t;
    return (u * u * u) * cubic0
        + (3.0 * u * u * t) * cubic1
        + (3.0 * u * t * t) * cubic2
        + (t * t * t) * cubic3;
}

void main()
{
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec3 hairMeshSize = imageSize(HairMeshImage);
    ivec3 styleSize = imageSize(HairUImage);

    if (texel.x >= hairMeshSize.x || texel.y >= hairMeshSize.y)
    {
        return;
    }

    uint bundleX = uint(texel.x) / 2u;
    uint bundleZ = uint(texel.y) / 2u;
    uint vertexX = bundleX + (uint(texel.x) & 1u);
    uint vertexZ = bundleZ + (uint(texel.y) & 1u);

    vec3 rootPoint = ReadSimPosition(0u, vertexX, vertexZ);
    vec3 midPoint = ReadSimPosition(1u, vertexX, vertexZ);
    vec3 tipPoint = ReadSimPosition(2u, vertexX, vertexZ);

    if (texel.z < hairMeshSize.z)
    {
        vec3 slicePoint;
        if (texel.z < 5)
        {
            vec3 previous = rootPoint - (midPoint - rootPoint);
            slicePoint = ComputeSlicePoint(previous, rootPoint, midPoint, tipPoint, texel.z);
        }
        else
        {
            vec3 after = tipPoint + (tipPoint - midPoint);
            slicePoint = ComputeSlicePoint(rootPoint, midPoint, tipPoint, after, texel.z - 4);
        }
        imageStore(HairMeshImage, texel, vec4(slicePoint, 1.0));
    }

    if (texel.z < styleSize.z)
    {
        uint patchVertexCount = PatchVertexCount();
        uint prevX = max(vertexX, 1u) - 1u;
        uint nextX = min(vertexX + 1u, patchVertexCount - 1u);
        uint prevZ = max(vertexZ, 1u) - 1u;
        uint nextZ = min(vertexZ + 1u, patchVertexCount - 1u);
        uint layerIndex = uint(texel.z);

        vec3 positionX0 = ReadSimPosition(layerIndex, prevX, vertexZ);
        vec3 positionX1 = ReadSimPosition(layerIndex, nextX, vertexZ);
        vec3 positionZ0 = ReadSimPosition(layerIndex, vertexX, prevZ);
        vec3 positionZ1 = ReadSimPosition(layerIndex, vertexX, nextZ);

        vec3 uAxis = HairRebuildSafeNormalize(positionX1 - positionX0, vec3(1.0, 0.0, 0.0));
        vec3 surfaceV = HairRebuildSafeNormalize(positionZ1 - positionZ0, vec3(0.0, 0.0, 1.0));
        vec3 wAxis = HairRebuildSafeNormalize(cross(surfaceV, uAxis), vec3(0.0, 1.0, 0.0));
        vec3 vAxis = HairRebuildSafeNormalize(cross(wAxis, uAxis), vec3(0.0, 0.0, 1.0));
        uAxis = HairRebuildSafeNormalize(cross(vAxis, wAxis), uAxis);

        imageStore(HairUImage, texel, vec4(uAxis, 0.0));
        imageStore(HairVImage, texel, vec4(vAxis, 0.0));
    }
}
