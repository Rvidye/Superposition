#version 460 core
#extension GL_EXT_ray_query : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 1, binding = 0) uniform sampler2D ipImage; // GBuffer depth
layout(set = 1, binding = 1, r32f) uniform writeonly image2DArray opImage; // Output: per-light visibility layers

layout(push_constant) uniform PushConstants {
	mat4 invViewMat;
	mat4 invProjMat;
	vec4 lightPosRange; // xyz = light world position, w = light range (0 = infinite)
	int layerIndex;     // which layer in image2DArray to write
};

void main(void) {
	ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 imageSize = imageSize(opImage).xy;

	// Bounds guard for non-multiple-of-8 frame sizes
	if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y)
		return;

	float depth = texelFetch(ipImage, pixelCoord, 0).r;

	// Sky pixels: fully lit (no geometry to shadow)
	if (depth >= 1.0) {
		imageStore(opImage, ivec3(pixelCoord, layerIndex), vec4(1.0));
		return;
	}

	// Reconstruct world-space position from depth
	vec2 uv = (vec2(pixelCoord) + vec2(0.5)) / vec2(imageSize);
	vec2 ndc = uv * 2.0 - 1.0;

	// Clip space -> view space -> world space
	vec4 clipPos = vec4(ndc, depth, 1.0);
	vec4 viewPos = invProjMat * clipPos;
	viewPos /= viewPos.w;
	vec3 worldPos = (invViewMat * viewPos).xyz;

	// Shadow ray from surface toward the light
	vec3 lightPos = lightPosRange.xyz;
	vec3 toLight = lightPos - worldPos;
	float distToLight = length(toLight);
	vec3 rayDir = toLight / distToLight;

	// Small origin bias to avoid self-intersection
	const float bias = 0.01;
	float tMin = bias;
	float tMax = distToLight - bias;

	// If surface is beyond or at the light, it's lit
	if (tMax <= tMin) {
		imageStore(opImage, ivec3(pixelCoord, layerIndex), vec4(1.0));
		return;
	}

	// Trace shadow ray
	rayQueryEXT query;
	rayQueryInitializeEXT(query, tlas,
		gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
		0xff, worldPos, tMin, rayDir, tMax);

	// Loop until traversal completes
	while (rayQueryProceedEXT(query)) {
		// Nothing to do - opaque geometry commits automatically
	}

	float visibility = 1.0; // lit by default
	if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
		visibility = 0.0; // occluded = shadowed
	}

	imageStore(opImage, ivec3(pixelCoord, layerIndex), vec4(visibility));
}
